# Compte/organisation qui publie l'image sur GitHub Container Registry.
GHCR_OWNER=e2483182
IMAGE_NAME=jeu-projet1
IMAGE_TAG=latest

# Port exposé sur la machine de déploiement.
PORT=3000

# Remplacez cette valeur par un secret aléatoire long avant le déploiement.
SESSION_SECRET=remplacer-par-une-cle-aleatoire-longue-et-unique

# Identifiants de l'application OAuth GitHub (jamais ceux d'un compte personnel).
GITHUB_CLIENT_ID=remplacer-par-votre-client-id
GITHUB_CLIENT_SECRET=remplacer-par-votre-client-secret
GITHUB_CALLBACK_URL=https://votre-domaine.example/auth/github/callback
